rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && userDoc().data.role == 'admin'; }
    function isShop() { return signedIn() && userDoc().data.role == 'shop'; }
    function shopId() { return userDoc().data.shopId; }

    function orderCoreUnchanged() {
      return request.resource.data.price == resource.data.price
        && request.resource.data.commission == resource.data.commission
        && request.resource.data.title == resource.data.title
        && request.resource.data.detail == resource.data.detail
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.shopName == resource.data.shopName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.priceLocked == resource.data.priceLocked;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'shop';
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken','updatedAt']));
      allow delete: if isAdmin();
    }

    match /shops/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow delete: if isAdmin();
      match /inventory/{itemId} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || (isShop() && shopId() == id);
      }
      match /branches/{branchId} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || (isShop() && shopId() == id);
      }
    }

    match /orders/{code} {
      allow create: if request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.commission is int
        && request.resource.data.commission >= 0
        && request.resource.data.priceLocked == true
        && request.resource.data.status == 'new'
        && request.resource.data.completed == false;
      allow get: if true;
      allow list: if isAdmin() || isShop();
      allow update: if isAdmin()
        || (isShop() && resource.data.shopId == shopId() && orderCoreUnchanged())
        || (
          orderCoreUnchanged()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'statusUpdatedAt',
            'cancelledAt'
          ])
          && request.resource.data.status in ['on_the_way','cancelled']
        );
      allow delete: if isAdmin();
      match /notes/{noteId} {
        allow read, create: if true;
        allow update, delete: if isAdmin();
      }
    }

    match /settlements/{id} {
      allow read: if isAdmin() || (isShop() && resource.data.shopId == shopId());
      allow create: if isShop() && request.resource.data.shopId == shopId();
      allow update, delete: if isAdmin();
    }
    match /offers/{id} {
      allow read: if resource.data.approved == true || isAdmin() || (isShop() && resource.data.shopId == shopId());
      allow create: if isShop() && request.resource.data.shopId == shopId();
      allow update: if isAdmin() || (isShop() && resource.data.shopId == shopId() && resource.data.approved != true);
      allow delete: if isAdmin() || (isShop() && resource.data.shopId == shopId());
    }
    match /size_requests/{id} {
      allow create, get: if true;
      allow list: if isAdmin() || isShop();
      allow update: if isAdmin() || isShop();
      allow delete: if isAdmin();
    }
    match /ratings/{orderCode} {
      allow create, get: if true;
      allow list: if true;
      allow update, delete: if isAdmin();
    }
    match /complaints/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /notifications/{id} {
      allow get, list, create: if true;
      allow update, delete: if isAdmin();
    }
    match /price_rules/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /price_history/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /availability_watch/{id} {
      allow create, get: if true;
      allow list, update, delete: if isAdmin() || isShop();
    }
    match /appointments/{id} {
      allow create, get: if true;
      allow list, update: if isAdmin() || isShop();
      allow delete: if isAdmin();
    }
    match /coupons/{code} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isShop();
    }
    match /media/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin() || isShop();
    }
  }
}

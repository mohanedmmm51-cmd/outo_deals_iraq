rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasUserDoc() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return hasUserDoc() && (
        userDoc().data.role == 'admin'
        || userDoc().data.get('isAdmin', false) == true
      );
    }
    function shopId() {
      return userDoc().data.get('shopId', '');
    }
    function ownsApprovedShop(id) {
      return signedIn()
        && id is string
        && id != ''
        && exists(/databases/$(database)/documents/shops/$(id))
        && get(/databases/$(database)/documents/shops/$(id)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/shops/$(id)).data.approved == true
        && get(/databases/$(database)/documents/shops/$(id)).data.get('status', 'approved') != 'suspended';
    }
    function isShop() {
      return hasUserDoc()
        && userDoc().data.role == 'shop'
        && userDoc().data.get('shopId', '') is string
        && ownsApprovedShop(userDoc().data.get('shopId', ''));
    }

    function terminalStatus(status) {
      return status in ['completed', 'cancelled', 'expired'];
    }

    function orderCatalog() {
      return get(/databases/$(database)/documents/security_config/order_catalog).data.products;
    }

    function trustedProductExists() {
      return request.resource.data.get('productId', '') is string
        && request.resource.data.get('productId', '') != ''
        && request.resource.data.get('productId', '') in orderCatalog();
    }

    function trustedProduct() {
      return orderCatalog()[request.resource.data.productId];
    }

    function trustedInventoryItemMatches() {
      return trustedProductExists()
        && trustedProduct().inventoryItemId is string
        && trustedProduct().inventoryItemId != ''
        && request.resource.data.get('inventoryItemId', '') == trustedProduct().inventoryItemId;
    }

    function trustedVariantExists() {
      return trustedProductExists()
        && request.resource.data.get('detail', '') is string
        && request.resource.data.get('detail', '') in trustedProduct().variants;
    }

    function trustedVariant() {
      return trustedProduct().variants[request.resource.data.detail];
    }

    function remotePriceRuleUsable() {
      return trustedVariantExists()
        && trustedVariant().priceRuleId is string
        && exists(/databases/$(database)/documents/price_rules/$(trustedVariant().priceRuleId))
        && get(/databases/$(database)/documents/price_rules/$(trustedVariant().priceRuleId)).data.value is int
        && get(/databases/$(database)/documents/price_rules/$(trustedVariant().priceRuleId)).data.value > 0;
    }

    function trustedOfferMatches() {
      let id = request.resource.data.get('offerId', '');
      let offer = get(/databases/$(database)/documents/offers/$(id)).data;
      return offer.approved == true
        && offer.shopId == request.resource.data.shopId
        && offer.productId == request.resource.data.productId
        && offer.productDetail == request.resource.data.detail
        && offer.price is int
        && offer.price > trustedVariant().commission
        && request.resource.data.price == offer.price;
    }

    function trustedPriceMatches() {
      return trustedVariantExists()
        && (
          (request.resource.data.get('offerId', '') != '' && trustedOfferMatches())
          || (request.resource.data.get('offerId', '') == '' && (
          (remotePriceRuleUsable()
            && request.resource.data.price
              == get(/databases/$(database)/documents/price_rules/$(trustedVariant().priceRuleId)).data.value)
          || (!remotePriceRuleUsable()
            && request.resource.data.price == trustedVariant().fallbackPrice)
        )));
    }

    function targetShopAvailable() {
      return request.resource.data.shopId is string
        && exists(/databases/$(database)/documents/shops/$(request.resource.data.shopId))
        && get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.approved == true
        && get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.get('status', 'approved') != 'suspended';
    }

    function targetShopMatches() {
      return targetShopAvailable()
        && request.resource.data.shopName
          == get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.name;
    }

    function validTrustedNewOrder(code) {
      return signedIn()
        && request.resource.data.get('customerUid', '') is string
        && request.resource.data.get('customerUid', '') == request.auth.uid
        && trustedVariantExists()
        && trustedInventoryItemMatches()
        && trustedPriceMatches()
        && request.resource.data.code == code
        && request.resource.data.title == trustedProduct().title
        && request.resource.data.commission == trustedVariant().commission
        && request.resource.data.priceLocked == true
        && request.resource.data.status == 'new'
        && request.resource.data.completed == false
        && request.resource.data.get('completedAt', null) == null
        && request.resource.data.get('settlementId', '') == ''
        && request.resource.data.get('settlementStatus', '') == ''
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.get('priceLockedAt', request.resource.data.createdAt) is timestamp
        && request.resource.data.get('inventoryCheckedAt', request.resource.data.createdAt) is timestamp
        && request.resource.data.expiresAt > request.resource.data.createdAt
        && targetShopMatches();
    }

    function orderCoreUnchanged() {
      return request.resource.data.get('code', '') == resource.data.get('code', '')
        && request.resource.data.get('customerUid', '') == resource.data.get('customerUid', '')
        && request.resource.data.price == resource.data.price
        && request.resource.data.commission == resource.data.commission
        && request.resource.data.title == resource.data.title
        && request.resource.data.detail == resource.data.detail
        && request.resource.data.get('offerId', '') == resource.data.get('offerId', '')
        && request.resource.data.get('productId', '') == resource.data.get('productId', '')
        && request.resource.data.get('inventoryItemId', '') == resource.data.get('inventoryItemId', '')
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.shopName == resource.data.shopName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('expiresAt', null) == resource.data.get('expiresAt', null)
        && request.resource.data.get('priceLocked', false) == resource.data.get('priceLocked', false)
        && request.resource.data.get('priceLockedAt', null) == resource.data.get('priceLockedAt', null)
        && request.resource.data.get('inventoryCheckedAt', null) == resource.data.get('inventoryCheckedAt', null);
    }

    function customerOwnsOrder() {
      return signedIn()
        && resource.data.get('customerUid', '') != ''
        && resource.data.get('customerUid', '') == request.auth.uid;
    }

    function canAccessOrderCode(code) {
      return exists(/databases/$(database)/documents/orders/$(code))
        && (
          isAdmin()
          || (
            signedIn()
            && get(/databases/$(database)/documents/orders/$(code)).data.get('customerUid', '') == request.auth.uid
          )
          || (
            isShop()
            && get(/databases/$(database)/documents/orders/$(code)).data.shopId == shopId()
          )
        );
    }

    function validOrderNote() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'text',
          'actorUid',
          'createdAt'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt is timestamp;
    }

    function inventoryCompletionSafe(code) {
      return get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.get('inventoryEnabled', false) != true
        || resource.data.get('inventoryItemId', '') == ''
        || (
          exists(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId))
          && get(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data.get('productId', '') == resource.data.get('productId', '')
          && get(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data.get('quantity', 0) is int
          && get(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data.get('quantity', 0) > 0
          && getAfter(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data.get('productId', '') == resource.data.get('productId', '')
          && getAfter(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data.get('quantity', -1)
            == get(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data.get('quantity', 0) - 1
          && (
            (get(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data.get('quantity', 0) == 1
              && getAfter(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data.get('available', true) == false)
            ||
            (get(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data.get('quantity', 0) > 1
              && getAfter(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data.get('available', false) == true)
          )
          && getAfter(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data.get('lastOrderCode', '') == code
          && getAfter(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data.get('lastSoldAt', null) == request.time
          && getAfter(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data.get('updatedAt', null) == request.time
          && getAfter(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data
            .diff(get(/databases/$(database)/documents/shops/$(resource.data.shopId)/inventory/$(resource.data.inventoryItemId)).data)
            .affectedKeys()
            .hasOnly([
              'quantity',
              'available',
              'lastOrderCode',
              'lastSoldAt',
              'updatedAt'
            ])
        );
    }

    function validShopCompletion(code) {
      return resource.data.get('completed', false) == false
        && !terminalStatus(resource.data.get('status', 'new'))
        && resource.data.expiresAt is timestamp
        && request.time < resource.data.expiresAt
        && exists(/databases/$(database)/documents/order_secrets/$(code))
        && get(/databases/$(database)/documents/order_secrets/$(code)).data.get('code', '') == code
        && get(/databases/$(database)/documents/order_secrets/$(code)).data.get('customerUid', '') == resource.data.get('customerUid', '')
        && get(/databases/$(database)/documents/order_secrets/$(code)).data.get('shopId', '') == resource.data.get('shopId', '')
        && get(/databases/$(database)/documents/order_secrets/$(code)).data.get('expiresAt', null) == resource.data.get('expiresAt', null)
        && request.resource.data.get('confirmationProof', '') is string
        && request.resource.data.get('confirmationProof', '') == get(/databases/$(database)/documents/order_secrets/$(code)).data.get('secret', '')
        && request.resource.data.get('completed', false) == true
        && request.resource.data.get('status', '') == 'completed'
        && request.resource.data.get('completedAt', null) == request.time
        && request.resource.data.get('statusUpdatedAt', null) == request.time
        && request.resource.data.get('inventoryConsumedAt', null) == request.time
        && inventoryCompletionSafe(code)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'statusUpdatedAt',
          'completed',
          'completedAt',
          'inventoryConsumedAt',
          'confirmationProof'
        ]);
    }

    function shopOrderFieldsAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'statusUpdatedAt',
        'acceptedAt',
        'completed',
        'completedAt',
        'inventoryConsumedAt',
        'confirmationProof'
      ]);
    }

    function shopLifecycleSafe(code) {
      return validShopCompletion(code)
        || (
          resource.data.get('completed', false) == false
          && request.resource.data.get('completed', false) == false
          && !terminalStatus(resource.data.get('status', 'new'))
          && request.resource.data.get('status', 'new') in ['new', 'accepted', 'on_the_way']
          && request.resource.data.get('completedAt', null) == resource.data.get('completedAt', null)
          && request.resource.data.get('inventoryConsumedAt', null) == resource.data.get('inventoryConsumedAt', null)
          && request.resource.data.get('confirmationProof', '') == resource.data.get('confirmationProof', '')
        );
    }

    function customerLifecycleSafe() {
      return resource.data.get('completed', false) != true
        && !terminalStatus(resource.data.get('status', 'new'));
    }

    function shopOwnerCoreUnchanged() {
      return request.resource.data.get('id', '') == resource.data.get('id', '')
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && request.resource.data.get('approved', false) == resource.data.get('approved', false)
        && request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending')
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    function shopOwnerFieldsAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'phone',
        'latitude',
        'longitude',
        'location',
        'locationAccuracy',
        'locationUpdatedAt',
        'updatedAt',
        'inventoryEnabled',
        'availableCount',
        'inventoryUpdatedAt'
      ]);
    }

    function notificationMatchesOrder(id) {
      return request.resource.data.orderCode is string
        && request.resource.data.targetShopId is string
        && id == request.resource.data.orderCode
        && request.resource.data.keys().hasOnly([
          'targetShopId',
          'title',
          'body',
          'orderCode',
          'createdAt'
        ])
        && request.resource.data.createdAt is timestamp
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderCode)).data.shopId
          == request.resource.data.targetShopId;
    }

    function validSupportMessage(sender) {
      return request.resource.data.keys().hasOnly([
          'sender',
          'text',
          'createdAt'
        ])
        && request.resource.data.sender == sender
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is timestamp;
    }

    function validCustomerRating(orderCode) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'orderCode',
          'shopId',
          'shopName',
          'stars',
          'comment',
          'createdAt'
        ])
        && request.resource.data.orderCode == orderCode
        && exists(/databases/$(database)/documents/orders/$(orderCode))
        && get(/databases/$(database)/documents/orders/$(orderCode)).data.get('customerUid', '') == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderCode)).data.get('completed', false) == true
        && get(/databases/$(database)/documents/orders/$(orderCode)).data.get('status', '') == 'completed'
        && request.resource.data.shopId == get(/databases/$(database)/documents/orders/$(orderCode)).data.get('shopId', '')
        && request.resource.data.shopName == get(/databases/$(database)/documents/orders/$(orderCode)).data.get('shopName', '')
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time;
    }

    function validCustomerComplaint() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'orderCode',
          'shopId',
          'shopName',
          'text',
          'status',
          'createdAt'
        ])
        && request.resource.data.orderCode is string
        && request.resource.data.orderCode != ''
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderCode))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderCode)).data.get('customerUid', '') == request.auth.uid
        && request.resource.data.shopId == get(/databases/$(database)/documents/orders/$(request.resource.data.orderCode)).data.get('shopId', '')
        && request.resource.data.shopName == get(/databases/$(database)/documents/orders/$(request.resource.data.orderCode)).data.get('shopName', '')
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
    }

    function validOfferProduct() {
      let d = request.resource.data;
      return d.get('productId', '') in orderCatalog()
        && d.get('productDetail', '') in orderCatalog()[d.productId].variants
        && d.get('price', 0) is int
        && d.price > orderCatalog()[d.productId].variants[d.productDetail].commission
        && d.price <= 100000000;
    }

    function validNewOffer() {
      return isShop()
        && request.resource.data.keys().hasOnly([
          'productId',
          'productDetail',
          'price',
          'title',
          'description',
          'shopId',
          'shopName',
          'approved',
          'createdAt',
          'updatedAt'
        ])
        && validOfferProduct()
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() > 0
        && request.resource.data.get('title', '').size() <= 120
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() > 0
        && request.resource.data.get('description', '').size() <= 2000
        && request.resource.data.get('shopId', '') == shopId()
        && request.resource.data.get('shopName', '')
          == get(/databases/$(database)/documents/shops/$(shopId())).data.name
        && request.resource.data.get('approved', true) == false
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('updatedAt', null) == request.time;
    }

    function validShopOfferUpdate() {
      return isShop()
        && resource.data.get('shopId', '') == shopId()
        && resource.data.get('approved', false) == false
        && request.resource.data.get('shopId', '') == resource.data.get('shopId', '')
        && request.resource.data.get('shopName', '') == resource.data.get('shopName', '')
        && request.resource.data.get('approved', true) == false
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('title', '') is string
        && request.resource.data.get('title', '').size() > 0
        && request.resource.data.get('title', '').size() <= 120
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() > 0
        && request.resource.data.get('description', '').size() <= 2000
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'description',
          'updatedAt'
        ]);
    }

    function validCouponCode(code) {
      return code.size() >= 3
        && code.size() <= 30
        && code.matches('^[A-Z0-9_-]{3,30}$');
    }

    function validNewShopCoupon(code) {
      return isShop()
        && validCouponCode(code)
        && request.resource.data.keys().hasOnly([
          'code',
          'discount',
          'active',
          'shopId',
          'shopName',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.get('code', '') == code
        && request.resource.data.get('discount', 0) is int
        && request.resource.data.get('discount', 0) > 0
        && request.resource.data.get('discount', 0) <= 1000000
        && request.resource.data.get('active', false) is bool
        && request.resource.data.get('shopId', '') == shopId()
        && request.resource.data.get('shopName', '')
          == get(/databases/$(database)/documents/shops/$(shopId())).data.name
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('updatedAt', null) == request.time;
    }

    function validShopCouponUpdate(code) {
      return isShop()
        && validCouponCode(code)
        && resource.data.get('shopId', '') == shopId()
        && resource.data.get('code', '') == code
        && request.resource.data.get('code', '') == resource.data.get('code', '')
        && request.resource.data.get('shopId', '') == resource.data.get('shopId', '')
        && request.resource.data.get('shopName', '') == resource.data.get('shopName', '')
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('discount', 0) is int
        && request.resource.data.get('discount', 0) > 0
        && request.resource.data.get('discount', 0) <= 1000000
        && request.resource.data.get('active', false) is bool
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'discount',
          'active',
          'updatedAt'
        ]);
    }

    function validNewMedia() {
      return isShop()
        && request.resource.data.keys().hasOnly([
          'url',
          'storagePath',
          'type',
          'ownerUid',
          'shopId',
          'shopName',
          'createdAt'
        ])
        && request.resource.data.get('url', '') is string
        && request.resource.data.get('url', '').size() > 0
        && request.resource.data.get('url', '').size() <= 4096
        && request.resource.data.get('storagePath', '') is string
        && request.resource.data.get('storagePath', '')
          .matches('^media/' + request.auth.uid + '/[^/]+$')
        && request.resource.data.get('type', '') in [
          'general',
          'shop',
          'product',
          'branch'
        ]
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.get('shopId', '') == shopId()
        && request.resource.data.get('shopName', '')
          == get(/databases/$(database)/documents/shops/$(shopId())).data.name
        && request.resource.data.get('createdAt', null) == request.time;
    }

    function ownsSizeRequest(requestId) {
      return signedIn()
        && exists(/databases/$(database)/documents/size_requests/$(requestId))
        && get(/databases/$(database)/documents/size_requests/$(requestId)).data.get('customerUid', '') == request.auth.uid;
    }

    function validNewSizeRequest(requestId) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'requestCode',
          'customerUid',
          'type',
          'size',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.requestCode == requestId
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.type.size() <= 50
        && request.resource.data.size is string
        && request.resource.data.size.size() > 0
        && request.resource.data.size.size() <= 100
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validShopSizeResponse(requestId, responseId) {
      return isShop()
        && responseId == shopId()
        && exists(/databases/$(database)/documents/size_requests/$(requestId))
        && get(/databases/$(database)/documents/size_requests/$(requestId)).data.get('status', '') == 'open'
        && request.resource.data.keys().hasOnly([
          'shopId',
          'shopName',
          'price',
          'note',
          'quotedAt'
        ])
        && request.resource.data.shopId == shopId()
        && request.resource.data.shopName
          == get(/databases/$(database)/documents/shops/$(shopId())).data.name
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.price <= 100000000
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 500
        && request.resource.data.quotedAt == request.time;
    }

    function ownsAvailabilityWatch(watchId) {
      return signedIn()
        && exists(/databases/$(database)/documents/availability_watch/$(watchId))
        && get(/databases/$(database)/documents/availability_watch/$(watchId)).data.get('customerUid', '') == request.auth.uid;
    }

    function validNewAvailabilityWatch() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'customerUid',
          'size',
          'active',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.size is string
        && request.resource.data.size.size() > 0
        && request.resource.data.size.size() <= 100
        && request.resource.data.active == true
        && request.resource.data.status == 'watching'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validCustomerAvailabilityCancel() {
      return signedIn()
        && resource.data.get('customerUid', '') == request.auth.uid
        && resource.data.get('active', false) == true
        && resource.data.get('status', '') == 'watching'
        && request.resource.data.get('active', true) == false
        && request.resource.data.get('status', '') == 'cancelled'
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'active',
          'status',
          'updatedAt'
        ]);
    }

    function validShopAvailabilityMatch(watchId, matchId) {
      return isShop()
        && matchId == shopId()
        && exists(/databases/$(database)/documents/availability_watch/$(watchId))
        && get(/databases/$(database)/documents/availability_watch/$(watchId)).data.get('active', false) == true
        && get(/databases/$(database)/documents/availability_watch/$(watchId)).data.get('status', '') == 'watching'
        && request.resource.data.keys().hasOnly([
          'shopId',
          'shopName',
          'note',
          'matchedAt'
        ])
        && request.resource.data.shopId == shopId()
        && request.resource.data.shopName
          == get(/databases/$(database)/documents/shops/$(shopId())).data.name
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 500
        && request.resource.data.matchedAt == request.time;
    }

    function validNewAppointment() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'customerUid',
          'shopId',
          'shopName',
          'service',
          'when',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && targetShopMatches()
        && request.resource.data.get('service', '') in ['شد وبلنص', 'تبديل بطارية']
        && request.resource.data.when is timestamp
        && request.resource.data.when > request.time
        && request.resource.data.when <= request.time + duration.value(90, 'd')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function appointmentCoreUnchanged() {
      return request.resource.data.get('customerUid', '') == resource.data.get('customerUid', '')
        && request.resource.data.get('shopId', '') == resource.data.get('shopId', '')
        && request.resource.data.get('shopName', '') == resource.data.get('shopName', '')
        && request.resource.data.get('service', '') == resource.data.get('service', '')
        && request.resource.data.get('when', null) == resource.data.get('when', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    function validCustomerAppointmentCancel() {
      return signedIn()
        && resource.data.get('customerUid', '') == request.auth.uid
        && resource.data.get('status', '') in ['pending', 'accepted']
        && request.resource.data.get('status', '') == 'cancelled'
        && request.resource.data.get('updatedAt', null) == request.time
        && appointmentCoreUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ]);
    }

    function validShopAppointmentUpdate() {
      return isShop()
        && resource.data.get('shopId', '') == shopId()
        && appointmentCoreUnchanged()
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ])
        && (
          (resource.data.get('status', '') == 'pending'
            && request.resource.data.get('status', '') in ['accepted', 'rejected'])
          || (resource.data.get('status', '') == 'accepted'
            && request.resource.data.get('status', '') in ['completed', 'cancelled'])
        );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'shop'
        && request.resource.data.get('isAdmin', false) == false;
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'shopId',
          'email',
          'fcmToken',
          'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    match /shops/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.approved == false
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.ownerUid == request.auth.uid
        && shopOwnerCoreUnchanged()
        && shopOwnerFieldsAllowed()
      );
      allow delete: if isAdmin();
      match /inventory/{itemId} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || (isShop() && shopId() == id);
      }
      match /branches/{branchId} {
        allow read: if true;
        allow create, update, delete: if isAdmin() || (isShop() && shopId() == id);
      }
    }

    match /orders/{code} {
      allow create: if validTrustedNewOrder(code);
      allow get: if isAdmin()
        || customerOwnsOrder()
        || (isShop() && resource.data.shopId == shopId())
        || (signedIn() && resource.data.get('customerUid', '') == '');
      allow list: if isAdmin() || (isShop() && resource.data.shopId == shopId());
      allow update: if isAdmin()
        || (
          isShop()
          && resource.data.shopId == shopId()
          && orderCoreUnchanged()
          && shopOrderFieldsAllowed()
          && shopLifecycleSafe(code)
        )
        || (
          customerOwnsOrder()
          && orderCoreUnchanged()
          && customerLifecycleSafe()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'statusUpdatedAt',
            'cancelledAt'
          ])
          && request.resource.data.status in ['on_the_way','cancelled']
        )
        || (
          customerOwnsOrder()
          && orderCoreUnchanged()
          && resource.data.get('status', 'new') == 'cancelled'
          && request.resource.data.get('status', 'new') == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'cancelledAt'
          ])
        );
      allow delete: if isAdmin();
      match /notes/{noteId} {
        allow read: if canAccessOrderCode(code);
        allow create: if canAccessOrderCode(code) && validOrderNote();
        allow update, delete: if isAdmin();
      }
    }

    match /order_secrets/{code} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'code',
          'secret',
          'customerUid',
          'shopId',
          'createdAt',
          'expiresAt'
        ])
        && request.resource.data.code == code
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.secret is string
        && request.resource.data.secret.size() == 12
        && request.resource.data.secret.matches('^[0-9]{12}$')
        && request.resource.data.shopId is string
        && request.resource.data.shopId != ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && getAfter(/databases/$(database)/documents/orders/$(code)).data.get('code', '') == code
        && getAfter(/databases/$(database)/documents/orders/$(code)).data.get('customerUid', '') == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(code)).data.get('shopId', '') == request.resource.data.shopId
        && getAfter(/databases/$(database)/documents/orders/$(code)).data.get('expiresAt', null) == request.resource.data.expiresAt;
      allow get: if isAdmin() || (
        signedIn() && resource.data.get('customerUid', '') == request.auth.uid
      );
      allow list: if isAdmin();
      allow update, delete: if false;
    }

    match /security_config/{document=**} {
      allow read, write: if false;
    }

    match /settlements/{id} {
      allow get: if isAdmin() || (
        isShop()
        && (
          id.matches(shopId() + '_.*')
          || resource.data.shopId == shopId()
        )
      );
      allow list: if isAdmin() || (isShop() && resource.data.shopId == shopId());
      allow create, update, delete: if isAdmin();
    }
    match /offers/{id} {
      allow get, list: if resource.data.get('approved', false) == true
        || isAdmin()
        || (isShop() && resource.data.get('shopId', '') == shopId());
      allow create: if validNewOffer();
      allow update: if isAdmin() || validShopOfferUpdate();
      allow delete: if isAdmin()
        || (isShop() && resource.data.get('shopId', '') == shopId());
    }
    match /size_requests/{id} {
      allow create: if validNewSizeRequest(id);
      allow get: if isAdmin() || isShop() || ownsSizeRequest(id);
      allow list: if isAdmin() || isShop();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /responses/{responseId} {
        allow get: if isAdmin()
          || ownsSizeRequest(id)
          || (isShop() && responseId == shopId());
        allow list: if isAdmin() || ownsSizeRequest(id);
        allow create, update: if validShopSizeResponse(id, responseId);
        allow delete: if isAdmin() || (isShop() && responseId == shopId());
      }
    }
    match /ratings/{orderCode} {
      allow create: if validCustomerRating(orderCode);
      allow read: if true;
      allow update, delete: if isAdmin();
    }
    match /complaints/{id} {
      allow create: if validCustomerComplaint();
      allow read, update, delete: if isAdmin();
    }
    match /support_threads/{threadId} {
      allow create: if signedIn()
        && request.auth.uid == threadId
        && request.resource.data.keys().hasOnly([
          'userUid',
          'userLabel',
          'status',
          'lastMessage',
          'lastSender',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.userLabel is string
        && request.resource.data.userLabel.size() > 0
        && request.resource.data.userLabel.size() <= 50
        && request.resource.data.status == 'open'
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastSender == ''
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow get: if signedIn()
        && (request.auth.uid == threadId || isAdmin());
      allow list: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == threadId
        && resource.data.userUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastSender',
          'status',
          'updatedAt'
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastSender == 'user'
        && request.resource.data.status == 'waiting'
        && request.resource.data.updatedAt is timestamp
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn()
          && (request.auth.uid == threadId || isAdmin());
        allow create: if signedIn() && (
          (request.auth.uid == threadId && validSupportMessage('user'))
          || (isAdmin() && validSupportMessage('admin'))
        );
        allow update, delete: if false;
      }
    }
    match /deletion_requests/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'userUid',
          'email',
          'status',
          'source',
          'requestedAt',
          'updatedAt'
        ])
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.status == 'pending'
        && request.resource.data.source in ['app', 'web']
        && request.resource.data.requestedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow get: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow update: if signedIn()
          && request.auth.uid == uid
          && resource.data.userUid == request.auth.uid
          && request.resource.data.userUid == request.auth.uid
          && request.resource.data.email == request.auth.token.get('email', '')
          && request.resource.data.status == 'pending'
          && request.resource.data.source in ['app', 'web']
          && request.resource.data.requestedAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email',
            'status',
            'source',
            'requestedAt',
            'updatedAt'
          ]);
      allow delete: if isAdmin();
    }
    match /notifications/{id} {
      allow get, list: if isAdmin() || (
        isShop() && resource.data.targetShopId == shopId()
      );
      allow create: if notificationMatchesOrder(id);
      allow update, delete: if isAdmin();
    }
    match /price_rules/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /price_history/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /availability_watch/{id} {
      allow create: if validNewAvailabilityWatch();
      allow get: if isAdmin()
        || ownsAvailabilityWatch(id)
        || (isShop() && resource.data.get('active', false) == true);
      allow list: if isAdmin()
        || (isShop() && resource.data.get('active', false) == true)
        || (signedIn() && resource.data.get('customerUid', '') == request.auth.uid);
      allow update: if isAdmin() || validCustomerAvailabilityCancel();
      allow delete: if isAdmin();

      match /matches/{matchId} {
        allow get: if isAdmin()
          || ownsAvailabilityWatch(id)
          || (isShop() && matchId == shopId());
        allow list: if isAdmin() || ownsAvailabilityWatch(id);
        allow create, update: if validShopAvailabilityMatch(id, matchId);
        allow delete: if isAdmin() || (isShop() && matchId == shopId());
      }
    }
    match /appointments/{id} {
      allow create: if validNewAppointment();
      allow get: if isAdmin()
        || (signedIn() && resource.data.get('customerUid', '') == request.auth.uid)
        || (isShop() && resource.data.get('shopId', '') == shopId());
      allow list: if isAdmin()
        || (signedIn() && resource.data.get('customerUid', '') == request.auth.uid)
        || (isShop() && resource.data.get('shopId', '') == shopId());
      allow update: if isAdmin()
        || validCustomerAppointmentCancel()
        || validShopAppointmentUpdate();
      allow delete: if isAdmin();
    }
    match /coupons/{code} {
      allow get: if resource.data.get('active', false) == true
        || isAdmin()
        || (isShop() && resource.data.get('shopId', '') == shopId());
      allow list: if isAdmin()
        || (isShop() && resource.data.get('shopId', '') == shopId());
      allow create: if isAdmin() || validNewShopCoupon(code);
      allow update: if isAdmin() || validShopCouponUpdate(code);
      allow delete: if isAdmin()
        || (isShop() && resource.data.get('shopId', '') == shopId());
    }
    match /media/{id} {
      allow read: if true;
      allow create: if validNewMedia();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (
        isShop()
        && resource.data.get('ownerUid', '') == request.auth.uid
        && resource.data.get('shopId', '') == shopId()
      );
    }
  }
}
